{
  "version": 1,
  "description": "agent-workbench build board",
  "project": { "owner": "ToanMobile", "title": "Agent Workbench", "number": 1 },
  "worker_backend": "claude-p",
  "model_tier": "medium",
  "target": { "type": "repo", "url": null },
  "repo": { "path": ".", "remote": "https://github.com/ToanMobile/agent-workbench" },
  "base_branch": "main",
  "timezone": "Asia/Ho_Chi_Minh",
  "columns": ["Backlog", "Ready", "Building", "QA", "Review", "Blocked", "Done"],
  "labels": ["qa", "bug", "feature"],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": false,
  "merge_policy": { "default": "auto", "auto_max_lines": 400, "allow_auto_on_production": false },
  "migrations": {
    "globs": ["supabase/migrations/**", "prisma/migrations/**", "drizzle/**", "**/migrations/*.sql", "db/migrate/**", "alembic/versions/**"],
    "allowed_envs": ["test", "staging"],
    "target_env": "staging",
    "commands": {},
    "checks": {},
    "human_steps": []
  },
  "tick_seconds": 30,
  "no_progress_cycles": 60,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "verify_commands": [
    "python3 universal-agent-devkit/bin/post-fix-gate.py --run-tests --full --brief --auto-approve-tests"
  ],
  "collect": { "sources": ["github", "prs", "architecture"], "window_days": 14 },
  "notifications": { "channel": "session", "chat_id": null, "bot_identity": "ToanMobile" }
}
