{
  "mcpServers": {
    "codebase-memory-mcp": {
      "command": "codebase-memory-mcp"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.1.1"
      ]
    },
    "agentmemory": {
      "command": "npx",
      "args": [
        "-y",
        "@agentmemory/agentmemory@0.9.29",
        "mcp"
      ]
    },
    "replicant-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "replicant-mcp@1.6.7"
      ],
      "env": {
        "ANDROID_HOME": "${ANDROID_HOME:-}"
      }
    },
    "play-store": {
      "command": "/Volumes/Data/Toan/agent-workbench/mcp-servers/play-store-mcp/.venv/bin/play-store-mcp",
      "args": [
        "--transport",
        "stdio"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS:-}",
        "PLAY_STORE_MCP_READ_ONLY": "true"
      }
    }
  }
}
