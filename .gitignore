# IDE
.idea/
.DS_Store

# Dependencies
node_modules/
package-lock.json
yarn.lock

# Build & dist
dist/
build/
out/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Temporary
.env.local
.env.*.local
temp/
tmp/

# universal-agent-devkit:start
# Local DevKit install state & *_old conflict backups (review/merge them, don't commit)
.claude/audit-gate/
.agents/context/
.agents/devkit
.agents/hooks/
.agents/regression_matrix.generated.json
.devkit_backups.log
.devkit-files
*_old
*_old.*
*_old_*
# universal-agent-devkit:end

# agent-workbench is public: personal agent memory and machine-local agent config stay local
.agents/local/memory/
.gemini/settings.json
.claude/agent-memory/
.claude/hooks/
.claude/commands/
.antigravity-pm/
.sandboxes/
reports/

# super-board: per-machine state (the config in .claude/super-board/configs/ is committed)
.claude/super-board/active
.claude/super-board/onboard-answers.json
.claude/super-board/onboard-staged/
.claude/super-board/backup/
.claude/super-board/inflight/
.claude/super-board/runner/
.claude/super-board/migrations/
.claude/super-board/upgrade.json
.claude/super-board/last-merge-verify-pr-*.log
# log chạy board do runner ghi liên tục (người dùng 17/10: không commit)
.claude/super-board/run-restart.log
# github-halt.json (dấu dừng board đang hiệu lực) và các bản lưu github-halt-*.json: trạng thái chạy, trunk mode chỉ cho động khi git bỏ qua
.claude/super-board/github-halt*.json
docs/super-board/runner.log
docs/super-board/current-worker.log
docs/super-board/runs/*-workers/
.claude/settings.json.bak-*
