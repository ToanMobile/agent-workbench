#!/usr/bin/env bash
# agent-kit — Management & Initialization CLI for Universal Agent DevKit
set -euo pipefail

# Called through a link (~/.local/bin/agent-kit, agent-install) the folder holding the
# link is not the DevKit: follow the links to the real file first (bash 3.2: no readlink -f).
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
DEVKIT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CMD="${1:-help}"

case "$CMD" in
  init|setup)
    shift
    # `init [path] [install.sh options]`: an optional leading non-flag argument is the
    # target; everything else goes to install.sh untouched. install.sh reads its menus
    # from /dev/tty itself when one can actually be opened, so no stdin redirection
    # here (a merely *existing* /dev/tty fails to open under CI / agent runners).
    TARGET="$PWD"
    if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
      TARGET="$1"
      shift
    fi
    exec bash "$DEVKIT_ROOT/bin/install.sh" --target="$TARGET" --domain=auto --mode=symlink "$@"
    ;;
  install-global)
    INSTALL_DIR="${HOME}/.local/bin"
    mkdir -p "$INSTALL_DIR"
    ln -sf "$DEVKIT_ROOT/bin/agent-kit" "$INSTALL_DIR/agent-kit"
    ln -sf "$DEVKIT_ROOT/bin/install.sh" "$INSTALL_DIR/agent-install"
    ln -sf "$DEVKIT_ROOT/bin/profile" "$INSTALL_DIR/agent-profile"
    ln -sf "$DEVKIT_ROOT/bin/agent-health.py" "$INSTALL_DIR/agent-health"
    ln -sf "$DEVKIT_ROOT/bin/post-fix-gate.py" "$INSTALL_DIR/postfix-gate"
    echo "✓ Global CLI installed to $INSTALL_DIR/agent-kit (+ agent-install, agent-profile, agent-health, postfix-gate)"
    echo "Ensure '$INSTALL_DIR' is in your PATH."
    echo "You can now run 'agent-kit init' inside any project directory!"
    ;;
  test|check)
    echo "================================================================="
    echo "  🧪 Running Hook Contract Tests..."
    echo "================================================================="
    bash "$DEVKIT_ROOT/hooks/tests/hook_contract_test.sh" || exit 1
    bash "$DEVKIT_ROOT/hooks/tests/or_ported_contract_test.sh" || exit 1
    echo
    echo "================================================================="
    echo "  📋 Running Hook Contract Facts (registries, headers, wiring)..."
    echo "================================================================="
    CONTRACT_FACTS_SKIP_HARNESS=1 bash "$DEVKIT_ROOT/hooks/tests/contract_facts_test.sh" || exit 1
    echo
    echo "================================================================="
    echo "  ⚡ Running Workflow Engine Tests..."
    echo "================================================================="
    node --test "$DEVKIT_ROOT/workflows"/*.test.mjs || exit 1
    echo
    echo "================================================================="
    echo "  🧰 Running Installer & Gate Regression Tests..."
    echo "================================================================="
    for t in "$DEVKIT_ROOT"/tests/test_*.sh; do
      echo "▶ $(basename "$t")"
      bash "$t" || exit 1
    done
    ;;
  sync)
    echo "Synchronizing commands and skills..."
    bash "$DEVKIT_ROOT/scripts/sync_commands.sh"
    ;;
  list|skills)
    skill_count="$(find "$DEVKIT_ROOT/skills" -mindepth 1 -maxdepth 1 -type d | wc -l | xargs)"
    echo "Available Skills in Universal Agent DevKit ($skill_count):"
    for skill_dir in "$DEVKIT_ROOT/skills"/*; do
      [ -d "$skill_dir" ] || continue
      skill_name="$(basename "$skill_dir")"
      echo "  - $skill_name"
    done
    ;;
  commands)
    echo "Available Slash Commands:"
    for cmd_file in "$DEVKIT_ROOT/commands"/*; do
      [ -f "$cmd_file" ] || continue
      cmd_name="$(basename "$cmd_file" .md)"
      echo "  - /$cmd_name"
    done
    ;;
  profile)
    shift || true
    python3 "$DEVKIT_ROOT/bin/agent-config.py" "$@"
    ;;
  health|check-health)
    shift || true
    python3 "$DEVKIT_ROOT/bin/agent-health.py" "$@"
    ;;
  gate|postfix|postfix-gate|audit-gate)
    shift || true
    python3 "$DEVKIT_ROOT/bin/post-fix-gate.py" "$@"
    ;;
  githooks|git-hooks)
    # githooks [install|uninstall|status] [path]
    shift || true
    bash "$DEVKIT_ROOT/scripts/githooks.sh" "${1:-status}" "${2:-$PWD}"
    ;;
  bugs)
    # bugs add "<title>" [opts] | link <BUG-ID> <test> | drop <BUG-ID> | import <table> [--dry-run] | [show]
    # — bugs in the regression checklist
    shift || true
    RC_PROJECT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
    RC=(python3 "$DEVKIT_ROOT/bin/regression_checklist.py" --project "$RC_PROJECT")
    case "${1:-show}" in
      add) shift; "${RC[@]}" add "$@" ;;
      link) shift; "${RC[@]}" bug-link "$@" ;;
      unlink) shift; "${RC[@]}" bug-unlink "$@" ;;
      drop) shift; "${RC[@]}" drop "$@" ;;
      import) shift; "${RC[@]}" import "$@" ;;
      show) "${RC[@]}" show ;;
      *) echo "agent-kit bugs: add \"<title>\" [--severity S] [--module M] [--evidence E] [--test REF] [--fixed] [--id BUG-ID]" >&2
         echo "                | link <BUG-ID> <test> | unlink <BUG-ID> <test> | drop <BUG-ID> | import <table> [--dry-run] | show" >&2; exit 2 ;;
    esac
    ;;
  req|reqs)
    # req add "<title>" --criterion … [--module M] [--source TEXT] [--inbox KEY] [--reason R] |
    #     link <REQ-ID> <n|all> <test> | drop <REQ-ID> — requirements in the regression checklist
    shift || true
    RC_PROJECT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
    RC=(python3 "$DEVKIT_ROOT/bin/regression_checklist.py" --project "$RC_PROJECT")
    case "${1:-}" in
      add) shift; "${RC[@]}" req-add "$@" ;;
      link) shift; "${RC[@]}" req-link "$@" ;;
      drop) shift; "${RC[@]}" drop "$@" ;;
      *) echo "agent-kit req: add \"<title>\" --criterion \"…\" [--criterion …] [--module M] [--source TEXT] [--inbox KEY] [--reason R]" >&2
         echo "               | link <REQ-ID> <n|all> <test> | drop <REQ-ID>" >&2; exit 2 ;;
    esac
    ;;
  memory-stats|recall)
    # memory-stats [project…] [--json] [--top N] — traps/rules the prompt hook surfaces on the
    # user's real prompts (replayed from Claude transcripts, read-only) and how often they are read
    shift || true
    python3 "$DEVKIT_ROOT/scripts/memory_stats.py" "$@"
    ;;
  nightly)
    # nightly run | add [path] | remove [path] | install [--hour H] [--minute M] | uninstall | status
    shift || true
    case "${1:-status}" in
      add|remove) python3 "$DEVKIT_ROOT/scripts/nightly.py" "$1" "${2:-${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}" ;;
      *) python3 "$DEVKIT_ROOT/scripts/nightly.py" "$@" ;;
    esac
    ;;
  learn)
    # learn "<title>" [--cause TEXT] [--rule TEXT] [--check CMD] [--file PATH] [--force] [--dry-run]
    shift || true
    python3 "$DEVKIT_ROOT/bin/instincts.py" add "$@"
    ;;
  clean)
    # clean [path] [--days=N] [--apply] [--old-installs] — dry-run unless --apply
    shift || true
    python3 "$DEVKIT_ROOT/scripts/devkit_clean.py" "$@"
    ;;
  matrix)
    # matrix [--write] — regression matrix from this project's own test runner
    shift || true
    python3 "$DEVKIT_ROOT/scripts/matrix_detect.py" "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" "$@"
    ;;
  worktree|wt)
    # worktree add <path> [branch] [--base=REF] [--profile=ID] [--no-init] | diff <path> | remove <path> | list
    shift || true
    python3 "$DEVKIT_ROOT/scripts/worktree.py" "$@"
    ;;
  completion)
    # completion [bash|zsh] — eval "$(agent-kit completion bash)" in ~/.bashrc (zsh: ~/.zshrc)
    shift || true
    case "${1:-bash}" in
      bash) ;;
      zsh) echo 'autoload -U +X bashcompinit && bashcompinit' ;;
      *) echo "agent-kit completion: bash | zsh" >&2; exit 2 ;;
    esac
    printf '_AGENT_KIT_ROOT=%q\n' "$DEVKIT_ROOT"
    cat "$DEVKIT_ROOT/completions/agent-kit.bash"
    ;;
  index-memory|index)
    shift || true
    # Default: the current project's failure memory (not the DevKit's own).
    TARGET_F="${1:-${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/.agents/instincts.md}"
    python3 "$DEVKIT_ROOT/scripts/index_memory.py" "$TARGET_F"
    ;;
  list-old|old|backups)
    shift || true
    bash "$DEVKIT_ROOT/scripts/backup_conflict.sh" list "${1:-$PWD}"
    ;;
  restore-old|restore)
    # restore-old [path] [--apply] — dry-run unless --apply
    shift || true
    R_TARGET="$PWD"; R_APPLY=""
    for a in "$@"; do
      case "$a" in
        --apply) R_APPLY="--apply" ;;
        -*) echo "agent-kit restore-old: unknown option '$a' (use --apply)" >&2; exit 2 ;;
        *) R_TARGET="$a" ;;
      esac
    done
    DEVKIT_ROOT="$DEVKIT_ROOT" bash "$DEVKIT_ROOT/scripts/backup_conflict.sh" restore "$R_TARGET" $R_APPLY
    ;;
  uninstall|remove)
    # uninstall [path] [--apply] — dry-run unless --apply; see scripts/devkit_uninstall.py
    shift || true
    python3 "$DEVKIT_ROOT/scripts/devkit_uninstall.py" "$@"
    ;;
  help|*)
    cat << HELP_EOF
Universal Agent DevKit CLI (agent-kit)

Usage:
  agent-kit <command> [arguments]

Commands:
  init [path] [opts]  Initialize AI agents in a project (opts are passed to install.sh,
                      e.g. -y, -p android, -a claude,cursor, -m copy, --lang=vi)
  install-global      Install 'agent-kit', 'agent-install' and 'postfix-gate' into ~/.local/bin
  profile [name|opts] Switch or inspect domain profile (see: agent-kit profile --help)
                      android | ios | web | backend | automotive | game | voice-assistant | universal
                      (case-insensitive; aliases e.g. xehoi, frontend, api)
  health              Run the health diagnostic
  gate                Run the post-fix static diff gate on the current changes
                      (--staged: static checks on the staged content only)
  githooks [install|uninstall|status] [path]
                      Git pre-commit hook running the gate's static checks on every
                      commit, also outside any agent (skip once: git commit --no-verify)
  bugs add "<title>" [--severity S] [--module M] [--evidence E] [--test REF] [--fixed] [--id BUG-ID]
                      One new bug in the regression checklist; prints its BUG id. OPEN until
                      fixed, NEEDS_TEST until a test is linked, never PASS. Same title + module
                      → the existing row. --id confirms a REPORTED row (bug prompts land there
                      automatically, from the UserPromptSubmit hook)
  bugs link <BUG-ID> <test>
                      Link the RED→GREEN test (matrix id, test file or class → the matrix suite
                      that runs it). NOT_RUN until the next real gate run
  bugs unlink <BUG-ID> <test>
                      Undo a link that is context, not a guard (a broad suite linked next to the real
                      test); the RED-proof becomes OUTDATED — every linked test must go red to be PROVEN
  bugs drop <BUG-ID>  Remove a bug row (a REPORTED prompt that was no bug, a duplicate)
  req add "<title>" --criterion "…" [--criterion …] [--module M] [--source TEXT] [--inbox KEY] [--reason R]
                      A requirement with acceptance criteria, written BEFORE the code and locked
                      by hash (changing them needs --reason). NEEDS_TEST until every criterion has
                      a test; PASS only after a real run and a RED-proof. --inbox takes over an
                      .agents/INBOX.md item (the prompt hook shows new ones with their key)
  req link <REQ-ID> <n|all> <test>
                      Link criterion n (or all) to a test: matrix id, test file or class
  req drop <REQ-ID>   Remove a REQ row
  memory-stats [path…] [--json] [--top N]
                      Failure-memory recall on REAL prompts: replays the user's typed prompts from
                      the project's Claude transcripts through the current prompt hook (read-only):
                      % that get a trap / a project rule, traps never shown, and how often a trap
                      the hook printed was then opened (live log: .claude/audit-gate/surfaced.jsonl)
  nightly add [path] | remove [path] | install [--hour H] [--minute M] | uninstall | status | run
                      Local nightly job (macOS LaunchAgent, default 02:17): every suite of each
                      added project for real (Gradle/Unity too), FAIL re-run once (FLAKY), pending
                      RED-proofs; a notification only when a row turns red; weekly one-line report
  bugs import <table> [--dry-run]
                      Past bugs into the regression checklist (.agents/CHECKLIST.md):
                      bug_id | title | severity | fixed? | module | test_id_or_NONE | evidence
                      (tab or | separated). Never PASS on import — shows which bugs no test guards
  learn "<title>" [--cause TEXT] [--rule TEXT] [--check CMD] [--dry-run]
                      Record a lesson in .agents/instincts.md as the next [INSTINCT-NNN]
                      (a title already recorded is refused; --force to add anyway)
  learn --from-json FILE [--dry-run]
                      Add every {"verdict":"INSTINCT", title, cause, rule, source, found_on}
                      item of a JSON list (e.g. classified old memory); re-runnable
  clean [path] [--days=N] [--apply] [--old-installs]
                      Remove hook logs, session state, restore backups and adb evidence
                      in .claude/audit-gate older than N days (default 14); trims logs over
                      5 MB. Never touches code or .agents/. Dry-run unless --apply
  matrix [--write]    Regression matrix generated from this project's test runner (gradle,
                      swift, npm/pnpm/yarn/bun, pytest, go, cargo, flutter); --write activates it
                      (agent-kit profile does this when the profile only has a sample matrix)
  worktree add <path> [branch] [--base=REF] [--profile=ID] [--no-init]
                      Git worktree for a parallel agent (branch default feat/<folder>), set up
                      like the main checkout: ignored local config copied, DevKit installed
  worktree diff <path>
                      Its own changes as a patch, DevKit setup left out; bring them back
                      with: agent-kit worktree diff ../app-x | git apply --3way
  worktree remove <path>
                      Remove it once every uncommitted change is in the main checkout
                      (the branch and its commits are kept)
  index-memory [file] Line-numbered index of a large .agents/instincts.md (default: this project's;
                      the SessionStart hook also refreshes it automatically above 20 KB)
  completion [bash|zsh]
                      Tab completion: add  eval "\$(agent-kit completion bash)"  to ~/.bashrc
                      (zsh: eval "\$(agent-kit completion zsh)" in ~/.zshrc)
  test                Run all regression suites (hook contract, workflow engine, installer & gate)
  sync                Resync skills, slash commands, and aliases
  list                List all curated skills
  commands            List all available slash commands
  list-old [path]     List preserved *_old files and the project tier (.agents/local):
                      which of your items are active and which a DevKit item shadows
  restore-old [path] [--apply]
                      Put *_old backups recorded by the installer back in place
                      (dry-run unless --apply; never overwrites non-DevKit content)
  uninstall [path] [--apply]
                      Remove what the installer added (DevKit links, unmodified copies,
                      DevKit hooks/MCP entries, marker blocks); your own files and edits
                      stay. Dry-run unless --apply; then run restore-old --apply
  help                Show this help message

Examples:
  agent-kit init                   # Interactive setup for current project
  agent-kit init ../my-app -y      # Non-interactive setup of another project
  agent-kit list-old               # Inspect preserved *_old folders and files
  agent-kit restore-old --apply    # Restore recorded *_old backups (see restore-old)
  agent-kit uninstall --apply && agent-kit restore-old --apply   # Remove the DevKit again
  agent-kit profile automotive     # Switch domain profile to Automotive (AAOS/CAN)
  agent-kit profile web            # Web front-end profile (Android/Unity skills left out)
  DEVKIT_LANG=en agent-kit health  # English output (order: --lang > DEVKIT_LANG > .active-profile.json > vi)
  agent-kit health                 # Run the health diagnostic
  agent-kit gate                   # Run post-fix quality gate
  agent-kit githooks install       # Check every git commit of this repo
  agent-kit learn "Token refresh race" --cause="two refreshes in flight" --rule="single-flight mutex"
  agent-kit test                   # Run all regression suites
HELP_EOF
    ;;
esac
