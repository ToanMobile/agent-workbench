#!/usr/bin/env python3
"""ocr-review [--from REF --to REF | --commit SHA] [-b TEXT] [--delegate-only] [--out DIR] — run OpenCodeReview (`ocr`) on the change in delegation mode.

  * Always OCR's delegation mode (#1332, owner 19/11: OCR's LLM is removed for good, `ocr review` is never called) —
    `ocr delegate preview` and `ocr delegate rule`, no LLM and no key: the files to review, their diff command and OCR's rules for
    them go into a spec (`mode: delegate`, `spec: <file>`) that the host agent hands to a fresh-context reviewer (Agent tool), who
    reports only real defects with file:line.
--delegate-only is accepted and does nothing (old callers; hooks/review_gate.sh runs it on a block: no cost, ~1 s).
-b TEXT is accepted for old callers and not passed to `ocr delegate`.
Output goes to a new temp folder (or --out DIR, reused and overwritten: review_gate passes one folder per repo so its block
message is the same text on every run), never into the repo. Exit 0: spec ready (or nothing to review); 1: ocr failed;
3: ocr is not installed; 64: unknown argument. -h/--help prints this. Standard library only.
"""
import json
import os
import re
import shutil
import shlex
import signal
import stat
import subprocess
import sys
import tempfile

# a hung `ocr` must not hang its caller: review_gate.sh runs --delegate-only inside its own 20 s hook budget (two calls, ~0.3-0.8 s
# each in the 5 repos, 13/10)
DELEGATE_TIMEOUT_S = 6
# an API key or bearer token that an ocr error may echo: never printed (it would land in the agent transcript)
SECRET_RX = re.compile(r"(sk-[A-Za-z0-9]{2,8}-)[A-Za-z0-9_-]{8,}|((?:x-api-key|authorization|bearer|token)[\"\x27:= ]+)[A-Za-z0-9._-]{12,}", re.I)


try:   # the kit's full key / token pattern list (regression_checklist.redact_secrets), next to this file
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    from regression_checklist import redact_secrets
except Exception as _e:   # SECRET_RX still masks the forms an LLM error echoes
    print("ocr-review: redact_secrets unavailable (%r); masking sk-/bearer forms only" % (_e,), file=sys.stderr)
    redact_secrets = None


def mask(text):
    text = SECRET_RX.sub(lambda m: (m.group(1) or m.group(2)) + "***", text or "")
    return redact_secrets(text) if redact_secrets else text


def _kill_group(p):
    """SIGKILL cả process group của ocr; macOS từ chối killpg (EPERM) hoặc group đã mất thì giết chính tiến trình đó
    (INSTINCT-056)."""
    try:
        os.killpg(p.pid, signal.SIGKILL)
        return
    except OSError as e:
        print("ocr-review: killpg(%d) failed (%r) — killing the process" % (p.pid, e), file=sys.stderr)
    try:
        p.kill()
    except OSError as e:   # tiến trình đã thoát giữa chừng: không còn gì để giết, chỉ ghi lại
        print("ocr-review: could not stop ocr (pid %d): %r" % (p.pid, e), file=sys.stderr)


def _reap(p, grace=30):
    """Output của ocr đã bị giết, có hạn: tiến trình cháu còn giữ pipe không bao giờ làm helper treo."""
    try:
        return p.communicate(timeout=grace)
    except subprocess.TimeoutExpired:
        return "", "ocr did not exit %ss after SIGKILL; output dropped" % grace


def ocr(*args, timeout=None):
    """`ocr …`, bounded. ocr.js spawns the native binary, so a timeout kills the whole process group, not node alone."""
    p = subprocess.Popen(["ocr", *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
    try:
        out, err = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        _kill_group(p)
        out, err = _reap(p)
        return subprocess.CompletedProcess(p.args, 124, out, (err or "") + "\nocr timed out after %ss" % timeout)
    except BaseException:
        _kill_group(p)
        raise
    return subprocess.CompletedProcess(p.args, p.returncode, out, err)


def range_args(argv):
    """(flags for `ocr delegate`, the diff command the spec names for one file). -b/--background là chủ đề của spec: giá trị của nó
    không bao giờ lọt vào `ocr delegate` thành đối số lạc."""
    dkeep, diff = [], ["git", "diff"]
    it = iter(argv)
    vals = {}
    for a in it:
        if a in ("--from", "--to", "--commit", "-c", "-b", "--background"):
            v = next(it, "")
            if a not in ("-b", "--background"):
                dkeep += [a, v]
            vals[a] = v
    if "--from" in vals and "--to" not in vals:   # `--from X` một mình: tới HEAD, như spec đọc
        dkeep += ["--to", "HEAD"]
    if "--commit" in vals or "-c" in vals:
        c = vals.get("--commit") or vals.get("-c")
        diff = ["git", "show", c, "--"]
    elif "--from" in vals:
        diff = ["git", "diff", vals["--from"] + "..." + vals.get("--to", "HEAD"), "--"]
    else:
        diff = ["git", "diff", "HEAD", "--"]      # workspace: staged + unstaged (new files: read them whole)
    return dkeep, diff


VALUED = ("--from", "--to", "--commit", "-c", "-b", "--background", "--out")   # the options range_args / main read, with a value


def check_args(argv):
    """#807: None to go on, else the exit code. -h/--help prints this docstring (0); an option or word the parser does not read
    exits 64 — both before any `ocr` call (--help used to run a real review of the uncommitted diff)."""
    it = iter(argv)
    for a in it:
        if a in VALUED:
            next(it, None)   # its value, even one that looks like a flag (-b "--help")
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        elif a != "--delegate-only":
            print("ocr-review: unknown argument %r (see --help)" % a, file=sys.stderr)
            return 64
    return None


def main(argv):
    rc = check_args(argv)
    if rc is not None:
        return rc
    if shutil.which("ocr") is None:
        print("ocr-review: `ocr` (OpenCodeReview) is not installed — npm i -g @alibaba-group/open-code-review", file=sys.stderr)
        print("ocr missing: install with npm i -g @alibaba-group/open-code-review")
        return 3
    out = ""
    if "--out" in argv:
        i = argv.index("--out")
        out = argv[i + 1] if i + 1 < len(argv) else ""
        argv = argv[:i] + argv[i + 2:]
    dkeep, diff = range_args([a for a in argv if a != "--delegate-only"])   # --delegate-only: no-op (#1332)
    if out:
        os.makedirs(out, mode=0o700, exist_ok=True)
        st = os.lstat(out)   # a folder another user made (or a symlink) at a guessable path would read or redirect the writes
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
            print("ocr-review: --out %s is not a folder of this user (symlink or foreign owner): refused" % out, file=sys.stderr)
            return 1
        os.chmod(out, 0o700)
    else:
        out = tempfile.mkdtemp(prefix="ocr-review.")
    # #1332: LLM của OCR gỡ hẳn (chủ repo 19/11) — luôn chạy delegation, không bao giờ gọi `ocr review`
    p = ocr("delegate", "preview", "--format", "json", *[a for a in dkeep if a], timeout=DELEGATE_TIMEOUT_S)
    try:
        prev = json.loads(p.stdout)
    except ValueError:
        print("ocr-review: `ocr delegate preview` failed: " + mask(p.stderr or p.stdout)[:500], file=sys.stderr)
        return 1
    files = [f.get("path") for f in prev.get("reviewable_files") or [] if f.get("path")]
    if not files:
        print("mode: delegate")
        print("nothing to review (ocr delegate preview: 0 reviewable files)")
        return 0
    g = ocr("delegate", "rule", "--format", "json", *files, timeout=DELEGATE_TIMEOUT_S)
    try:
        groups = json.loads(g.stdout).get("groups") or []
    except ValueError:
        print("ocr-review: `ocr delegate rule` failed: " + mask(g.stderr or g.stdout)[:500], file=sys.stderr)
        return 1
    spec = os.path.join(out, "ocr-spec.md")
    lines = ["# OCR review spec (OpenCodeReview delegation mode)", "",
             "Review ONLY these files, with fresh context. For each, read the change with the command shown (a new file: read it "
             "whole). Report only real defects you can point to: file:line, what breaks, why. Precision over recall: no style "
             "notes, no guesses. Apply the OCR rules listed for each file.", "",
             "## Files (" + str(len(files)) + ")"]
    meta = {f.get("path"): f for f in prev.get("reviewable_files") or []}
    for f in files:
        m = meta.get(f, {})
        lines.append("- `%s` (%s, +%s/-%s): `%s`" % (f, m.get("status", "?"), m.get("insertions", "?"), m.get("deletions", "?"),
                                                     shlex.join(diff + [f])))
    for grp in groups:
        lines += ["", "## OCR rules for: " + ", ".join("`%s`" % x for x in grp.get("files") or []), "", grp.get("rule", "").strip()]
    with open(spec, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")
    print("mode: delegate")
    print("spec: " + spec)
    print("next: give this spec to a fresh-context reviewer (Agent tool); its findings are the OCR review")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
